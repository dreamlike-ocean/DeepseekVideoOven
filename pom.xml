<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.dreamlike</groupId>
    <artifactId>DeepseekVideoOven</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <native.lib.dir>${project.build.directory}/native-libs</native.lib.dir>
        <jackson.version>2.18.2</jackson.version>
        <main.class>io.github.dreamlike.deepseekvideooven.App</main.class>
        <skip.native.build>false</skip.native.build>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>whisper-cmake-configure</id>
                        <phase>generate-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>cmake</executable>
                            <workingDirectory>${project.basedir}/whisper.cpp</workingDirectory>
                            <arguments>
                                <argument>-B</argument><argument>build</argument>
                                <argument>-DBUILD_SHARED_LIBS=ON</argument>
                                <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                            </arguments>
                            <skip>${skip.native.build}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>whisper-cmake-build</id>
                        <phase>generate-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>cmake</executable>
                            <workingDirectory>${project.basedir}/whisper.cpp</workingDirectory>
                            <arguments>
                                <argument>--build</argument><argument>build</argument>
                                <argument>--config</argument><argument>Release</argument>
                            </arguments>
                            <skip>${skip.native.build}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-ffmpeg-bridge</id>
                        <phase>generate-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>mkdir -p ${native.lib.dir} &amp;&amp; gcc -shared -fPIC -O3 $(pkg-config --cflags libavformat libavcodec libavfilter libswresample libavutil 2>/dev/null || echo "-I/opt/homebrew/include") -o ${native.lib.dir}/libffmpeg_bridge.dylib ${project.basedir}/native/ffmpeg_bridge.c $(pkg-config --libs libavformat libavcodec libavfilter libswresample libavutil 2>/dev/null || echo "-L/opt/homebrew/lib -lavformat -lavcodec -lavfilter -lswresample -lavutil")</argument>
                            </arguments>
                            <skip>${skip.native.build}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-whisper-bridge</id>
                        <phase>generate-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>mkdir -p ${native.lib.dir} &amp;&amp; gcc -shared -fPIC -O3 -I${project.basedir}/whisper.cpp/include -I${project.basedir}/whisper.cpp/ggml/include -o ${native.lib.dir}/libwhisper_bridge.dylib ${project.basedir}/native/whisper_bridge.c -L${project.basedir}/whisper.cpp/build/src -lwhisper -Wl,-rpath,@loader_path</argument>
                            </arguments>
                            <skip>${skip.native.build}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-whisper-lib</id>
                        <phase>process-classes</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <skip>${skip.native.build}</skip>
                            <target>
                                <mkdir dir="${native.lib.dir}"/>
                                <copy todir="${native.lib.dir}" failonerror="false" quiet="true">
                                    <fileset dir="${project.basedir}/whisper.cpp/build">
                                        <include name="*.dylib"/>
                                        <include name="*.so"/>
                                        <include name="*.dll"/>
                                    </fileset>
                                    <fileset dir="${project.basedir}/whisper.cpp/build/src">
                                        <include name="*.dylib"/>
                                        <include name="*.so"/>
                                        <include name="*.dll"/>
                                    </fileset>
                                    <fileset dir="${project.basedir}/whisper.cpp/build/src/Release">
                                        <include name="*.dll"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.5</version>
                        <extensions>true</extensions>
                        <configuration>
                            <imageName>video-oven</imageName>
                            <mainClass>${main.class}</mainClass>
                            <buildArgs>
                                <arg>-H:+ForeignAPISupport</arg>
                                <arg>--enable-native-access=ALL-UNNAMED</arg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>dev</id>
            <properties>
                <skip.native.build>true</skip.native.build>
            </properties>
        </profile>
    </profiles>
</project>
